{
  "name": "lfaa-deliverables-tool-present",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "joi": "^17.0.0",
    "lfaa-tools": "workspace:*",
    "lfaa-util-values": "workspace:*",
    "lfaa-deliverables-workspace-changes": "workspace:*"
  },
  "scripts": {
    "build": "node ../../../scripts/build-harness.mjs package"
  },
  "lfaa": {
    "server": {
      "entry": "./src/index.ts",
      "inject": ["lfaaTools"],
      "required": true,
      "capabilities": [],
      "settings": []
    }
  }
}
