{
  "name": "@lfaa/chat",
  "description": "LFAA 核心聊天与 Agent 工作台业务包，提供会话管理、流式思考/行动/检查步骤可视化与模型规则设置界面。",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
