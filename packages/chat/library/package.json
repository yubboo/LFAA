    "@lfaa/tool-media": "workspace:*",
    "@tabler/icons-react": "3.52.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  },
  "main": "./lib/index.js",
