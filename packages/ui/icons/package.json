{
  "name": "@lfaa/ui-icons",
  "description": "LFAA 共享文件类型图标包：彩色文件/文件夹图标与扩展名映射，供文件树、标签栏、面包屑与变更列表复用。",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/src/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contract": {
      "types": "./lib/types/contract/index.d.ts",
      "default": "./lib/types/contract/index.js"
    },
    "./src/*": "./src/*",
    "./client": "./client/index.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -b ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/src/index.d.ts",
  "files": [
    "lib",
    "src",
    "client",
    "contract"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yubboo/LFAA.git",
    "directory": "packages/ui/icons"
  }
}
