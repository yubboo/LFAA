{
  "name": "@lfaa/ui-theme",
  "description": "LFAA 液态玻璃主题系统与外观设置插件包，提供无 DOM 主题预设契约及 Cordis Client 外观视图贡献。",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./client": "./client/index.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -b ."
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@lfaa/ui-layout": "workspace:*",
    "@tabler/icons-react": "3.52.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "src",
    "client"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yubboo/LFAA.git",
    "directory": "packages/ui/theme"
  }
}
