{
  "name": "lfaa-api-account-controller",
  "private": true,
  "type": "module",
  "version": "0.1.1",
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@simplewebauthn/server": "14.0.3",
    "express": "^4.0.0",
    "lfaa-api-gateway": "workspace:*",
    "lfaa-api-remotes": "workspace:*",
    "lfaa-app-boot": "workspace:*",
    "lfaa-authorization": "workspace:*",
    "lfaa-identity-auth": "workspace:*",
    "lfaa-storage-sqlite": "workspace:*",
    "lfaa-typert-loader": "workspace:*",
    "lfaa-typert-protocol": "workspace:*",
    "lfaa-util-values": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/js-yaml": "^4.0.0",
    "lfaa-typert-generator": "workspace:*"
  },
  "exports": {
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate:remote": "lfaa-typert-generate --source src/client-contract.ts --type AccountControllerRemoteContract --output src/client-contract.generated.ts",
    "build": "node ../../../scripts/build-harness.mjs package"
  }
}
