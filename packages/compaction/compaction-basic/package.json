{
  "name": "@lfaa/compaction-basic",
  "description": "LFAA 上下文压缩服务：把预算压缩暴露成可替换服务，默认复用 @lfaa/context 的实现。",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -b ."
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@lfaa/context": "workspace:*",
    "@lfaa/llm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yubboo/LFAA.git",
    "directory": "packages/compaction/compaction-basic"
  }
}