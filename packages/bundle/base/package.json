    "lfaa-jobs": "workspace:*",
    "lfaa-permission-presets": "workspace:*",
    "lfaa-session": "workspace:*",
    "lfaa-settings": "workspace:*",
    "lfaa-storage-sqlite": "workspace:*",
    "lfaa-tools": "workspace:*",
    "lfaa-workspace-data-directory": "workspace:*",
