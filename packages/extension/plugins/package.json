{
  "name": "@lfaa/plugins",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/src/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contract": {
      "types": "./lib/types/contract/index.d.ts",
      "default": "./lib/types/contract/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -b ."
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@lfaa/tools": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@deepseek-ai/cordis-plugin-loader": "workspace:*",
    "@types/react-dom": "^19.3.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/src/index.d.ts",
  "files": [
    "lib",
    "src",
    "contract",
    "locale/*.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yubboo/LFAA.git",
    "directory": "packages/extension/plugins"
  }
}
