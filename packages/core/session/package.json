{
  "name": "@lfaa/session",
  "description": "LFAA 会话领域：消息/步骤/指标契约、本地会话文件读写、标题生成与历史摘要。",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
