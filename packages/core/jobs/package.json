{
  "name": "@lfaa/jobs",
  "description": "LFAA 会话隔离后台任务管理器：支持后台命令启动、实时日志流解码、状态查询与进程树终止。",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -b ."
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@lfaa/shell": "workspace:*",
    "@lfaa/tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yubboo/LFAA.git",
    "directory": "packages/core/jobs"
  }
}
