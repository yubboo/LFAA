{
  "name": "@lfaa/web-server",
  "description": "LFAA Web 宿主服务：装配运行时与全部 HTTP 接口，开发态托管 Vite、生产态托管 Web 产物。",
  "version": "0.1.0",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yubboo/LFAA.git",
    "directory": "packages/host/web-server"
  },
  "scripts": {
    "typecheck": "tsc -b ."
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@lfaa/agent": "workspace:*",
    "@lfaa/agent-group": "workspace:*",
    "@lfaa/agent-profile": "workspace:*",
    "@lfaa/api-gateway": "workspace:*",
    "@lfaa/attachment-local": "workspace:*",
    "@lfaa/browser": "workspace:*",
    "@lfaa/bundle-web": "workspace:*",
    "@lfaa/chat": "workspace:*",
    "@lfaa/canvas": "workspace:*",
    "@lfaa/commands": "workspace:*",
    "@lfaa/connectors": "workspace:*",
    "@lfaa/goal": "workspace:*",
    "@lfaa/handoff": "workspace:*",
    "@lfaa/jobs": "workspace:*",
    "@lfaa/llm": "workspace:*",
    "@lfaa/mcp": "workspace:*",
    "@lfaa/memory": "workspace:*",
    "@lfaa/message-feedback": "workspace:*",
    "@lfaa/plugins": "workspace:*",
    "@lfaa/review": "workspace:*",
    "@lfaa/rules": "workspace:*",
    "@lfaa/sandbox": "workspace:*",
    "@lfaa/sections": "workspace:*",
    "@lfaa/session-title": "workspace:*",
    "@lfaa/skills": "workspace:*",
    "@lfaa/subagent": "workspace:*",
    "@lfaa/terminal": "workspace:*",
    "@lfaa/tool-media": "workspace:*",
    "@lfaa/workspace": "workspace:*",
    "@lfaa/worktree": "workspace:*",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
