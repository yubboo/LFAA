{
  "name": "@lfaa/worktree",
  "description": "Git 工作树隔离：按会话创建独立检出目录、读取状态并在安全校验后清理。",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b ."
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@lfaa/workspace": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/src/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contract": {
      "types": "./lib/types/contract/index.d.ts",
      "default": "./lib/types/contract/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "contract",
    "locale/*.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yubboo/LFAA.git",
    "directory": "packages/workspace/worktree"
  }
}
