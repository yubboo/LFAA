{
  "name": "lfaa-skill-writing",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "dependencies": {
    "lfaa-skill": "workspace:*",
    "@deepseek-ai/cordis": "4.0.4",
    "lfaa-agent": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/js-yaml": "^4.0.0"
  },
  "scripts": {
    "build": "node ../../../scripts/build-harness.mjs package"
  },
  "lfaa": {
    "server": {
      "entry": "./src/index.ts",
      "inject": [
        "skills"
      ],
      "required": true,
      "capabilities": [],
      "settings": []
    }
  }
}
