{
  "name": "lfaa-capability-installs",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "lfaa": {
    "server": {
      "entry": "./src/index.ts",
      "inject": ["lfaaTools"],
      "required": true,
      "capabilities": [],
      "settings": []
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "joi": "^17.0.0",
    "lfaa-util-values": "workspace:*",
    "lfaa-tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "scripts": {
    "build": "node ../../../scripts/build-harness.mjs package"
  }
}
