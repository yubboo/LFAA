{
  "name": "lfaa-client-ui-sidebar-terminal",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "antd": "^5.0.0",
    "lfaa-client-connection": "workspace:*",
    "lfaa-client-ui-primitives": "workspace:*",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0"
  },
  "lfaa": {
    "client": {
      "platform": "web",
      "inject": ["lfaa-client-connection", "lfaa-client-ui-primitives"]
    }
  },
  "scripts": {
    "build": "node ../../../scripts/build-harness.mjs package"
  }
}
