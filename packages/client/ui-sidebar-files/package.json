{
  "name": "lfaa-client-ui-sidebar-files",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@deepseek-ai/cordis": "4.0.4",
    "@lezer/highlight": "^1.2.5",
    "antd": "^5.0.0",
    "codemirror": "^6.0.2",
    "lfaa-client-connection": "workspace:*",
    "lfaa-client-modules": "workspace:*",
    "lfaa-client-store": "workspace:*",
    "lfaa-client-ui-dockkit": "workspace:*",
    "lfaa-client-ui-primitives": "workspace:*",
    "lfaa-client-ui-sidebar": "workspace:*",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0"
  },
  "lfaa": {
    "client": {
      "platform": "web",
      "inject": [
        "lfaa-client-connection",
        "lfaa-client-modules",
        "lfaa-client-ui-primitives",
        "lfaa-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node ../../../scripts/build-harness.mjs package"
  }
}
