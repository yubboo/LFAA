{
  "name": "@lfaa/client-ui-browser",
  "description": "LFAA 内置浏览器服务与可视化控制面板：遵循 DSH browser-use 独占注册契约，基于 playwright-core 复用本机 Edge/Chrome 驱动。（浏览器半，已从 @lfaa/browser 拆出）。",
  "version": "0.1.0",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./client": "./client/index.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yubboo/LFAA.git",
    "directory": "packages/client/ui-browser"
  },
  "scripts": {
    "typecheck": "tsc -b ."
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@lfaa/browser": "workspace:*",
    "@lfaa/ui-layout": "workspace:*",
    "@lfaa/ui-primitives": "workspace:*",
    "@tabler/icons-react": "^3.35.0",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
