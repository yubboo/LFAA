{
  "name": "lfaa-client-ui-chat",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "antd": "^5.0.0",
    "lfaa-client-connection": "workspace:*",
    "lfaa-client-modules": "workspace:*",
    "lfaa-client-resources": "workspace:*",
    "lfaa-client-store": "workspace:*",
    "lfaa-client-ui-primitives": "workspace:*",
    "lfaa-client-ui-approval": "workspace:*",
    "lfaa-client-ui-attachment": "workspace:*",
    "lfaa-client-ui-input-trigger": "workspace:*",
    "lfaa-client-ui-message-feedback": "workspace:*",
    "lfaa-client-ui-model-selection": "workspace:*",
    "lfaa-client-ui-plan": "workspace:*",
    "lfaa-client-ui-settings-models": "workspace:*",
    "lfaa-client-ui-user-questions": "workspace:*",
    "lfaa-client-ui-trajectory": "workspace:*",
    "lfaa-client-ui-writing": "workspace:*",
    "lfaa-client-ui-commands": "workspace:*",
    "lfaa-client-ui-conversation": "workspace:*",
    "react": "^18.0.0",
    "lfaa-util-values": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/express": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/js-yaml": "^4.0.0"
  },
  "lfaa": {
    "client": {
      "platform": "web",
      "inject": [
        "lfaa-client-connection",
        "lfaa-client-modules",
        "lfaa-client-resources",
        "lfaa-client-store",
        "lfaa-client-ui-primitives",
        "lfaa-client-ui-settings-models",
        "lfaa-client-ui-commands"
      ]
    }
  },
  "scripts": {
    "build": "node ../../../scripts/build-harness.mjs package"
  }
}
