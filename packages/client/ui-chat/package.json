{
    "name":  "@lfaa/client-ui-chat",
    "description":  "LFAA 核心聊天与 Agent 工作台业务包，提供会话管理、流式思考/行动/检查步骤可视化与模型规则设置界面。（浏览器半，已从 @lfaa/chat 拆出）。",
    "version":  "0.1.0",
    "type":  "module",
    "main":  "./lib/index.js",
    "types":  "./lib/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./src/*":  "./src/*",
                    "./client":  "./client/index.tsx",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "src",
                  "client"
              ],
    "publishConfig":  {
                          "access":  "public"
                      },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/yubboo/LFAA.git",
                       "directory":  "packages/client/ui-chat"
                   },
    "scripts":  {
                    "typecheck":  "tsc -b ."
                },
    "dependencies":  {
                         "@deepseek-ai/cordis":  "^4.1.0",
                         "@lfaa/client-ui-browser":  "workspace:*",
                         "@lfaa/client-ui-tool-media":  "workspace:*",
                         "@lfaa/llm":  "workspace:*",
                         "@lfaa/memory":  "workspace:*",
                         "@lfaa/metrics":  "workspace:*",
                         "@lfaa/ui-icons":  "workspace:*",
                         "@lfaa/ui-layout":  "workspace:*",
                         "@lfaa/ui-primitives":  "workspace:*",
                         "@tabler/icons-react":  "^3.35.0",
                         "react":  "^19.1.0",
                         "react-dom":  "^19.1.0"
                     },
    "devDependencies":  {
                            "@types/react":  "^19.3.0",
                            "typescript":  "^5.9.3",
                            "@lfaa/chat":  "workspace:*"
                        }
}