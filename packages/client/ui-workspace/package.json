{
  "name": "lfaa-client-ui-workspace",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "antd": "^5.0.0",
    "lfaa-client-connection": "workspace:*",
    "lfaa-client-modules": "workspace:*",
    "lfaa-client-resources": "workspace:*",
    "lfaa-client-store": "workspace:*",
    "lfaa-client-ui-theme": "workspace:*",
    "lfaa-client-ui-chat": "workspace:*",
    "lfaa-client-ui-dockkit": "workspace:*",
    "lfaa-client-ui-minecraft": "workspace:*",
    "lfaa-client-ui-connectivity": "workspace:*",
    "lfaa-client-ui-primitives": "workspace:*",
    "lfaa-client-ui-sidebar": "workspace:*",
    "lfaa-client-ui-settings-general": "workspace:*",
    "lfaa-client-ui-writing": "workspace:*",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/express": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/js-yaml": "^4.0.0"
  },
  "lfaa": {
    "client": {
      "platform": "web",
      "inject": [
        "lfaa-client-connection",
        "lfaa-client-modules",
        "lfaa-client-resources",
        "lfaa-client-store",
        "lfaa-client-ui-chat",
        "lfaa-client-ui-dockkit",
        "lfaa-client-ui-minecraft",
        "lfaa-client-ui-connectivity",
        "lfaa-client-ui-primitives",
        "lfaa-client-ui-sidebar",
        "lfaa-client-ui-settings-general",
        "lfaa-client-ui-theme",
        "lfaa-client-ui-writing"
      ]
    }
  },
  "scripts": {
    "build": "node ../../../scripts/build-harness.mjs package"
  }
}
