{
  "name": "@lfaa/client-ui-workspace",
  "description": "LFAA 工作区与本地项目插件包，提供 Host 服务契约与 Client 侧栏/工作区/右侧上下文面板贡献。（浏览器半，已从 @lfaa/workspace 拆出）。",
  "version": "0.1.0",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./client": "./client/index.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yubboo/LFAA.git",
    "directory": "packages/client/ui-workspace"
  },
  "scripts": {
    "typecheck": "tsc -b ."
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@lfaa/ui-layout": "workspace:*",
    "@lfaa/ui-primitives": "workspace:*",
    "@lfaa/workspace": "workspace:*",
    "@tabler/icons-react": "^3.35.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
