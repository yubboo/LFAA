{
  "name": "lfaa-client-web",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "lfaa-client-modules": "workspace:*",
    "lfaa-client-ui-chat": "workspace:*",
    "lfaa-client-ui-commands": "workspace:*",
    "lfaa-client-ui-dockkit": "workspace:*",
    "lfaa-client-ui-layout": "workspace:*",
    "lfaa-client-ui-minecraft": "workspace:*",
    "lfaa-client-ui-primitives": "workspace:*",
    "lfaa-client-ui-renderer": "workspace:*",
    "lfaa-client-ui-settings": "workspace:*",
    "lfaa-client-ui-settings-account": "workspace:*",
    "lfaa-client-ui-settings-general": "workspace:*",
    "lfaa-client-ui-sidebar": "workspace:*",
    "lfaa-client-ui-sidebar-files": "workspace:*",
    "lfaa-client-ui-workspace": "workspace:*",
    "lfaa-client-ui-writing": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/express": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/js-yaml": "^4.0.0"
  },
  "lfaa": {
    "client": {
      "platform": "web",
      "inject": [
        "lfaa-client-ui-layout",
        "lfaa-client-ui-renderer",
        "lfaa-client-ui-settings-account",
        "lfaa-client-ui-theme",
        "lfaa-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "node ../../../scripts/build-harness.mjs package"
  }
}
