{
  "name": "lfaa-daemon",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "predev": "pnpm run build:sandbox",
    "dev": "node src/task-runner/minecraft-daemon.mjs",
    "check": "node --check src/task-runner/minecraft-daemon.mjs",
    "build:sandbox": "cargo build --manifest-path sandbox-host/Cargo.toml --release --target-dir ../dist/daemon/target --target x86_64-pc-windows-msvc",
    "build": "pnpm run build:sandbox && pnpm run check"
  }
}
