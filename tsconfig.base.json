{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@lfaa/agent": ["./packages/core/agent/src"],
      "@lfaa/agent/client": ["./packages/core/agent/client"],
      "@lfaa/api-gateway": ["./packages/api/gateway/src"],
      "@lfaa/api-gateway/client": ["./packages/api/gateway/client"],
      "@lfaa/bash-local": ["./packages/shell/bash-local/src"],
      "@lfaa/bash-local/client": ["./packages/shell/bash-local/client"],
      "@lfaa/browser": ["./packages/core/browser/src"],
      "@lfaa/browser/client": ["./packages/core/browser/client"],
      "@lfaa/bundle-web": ["./packages/bundle/web/src"],
      "@lfaa/bundle-web/client": ["./packages/bundle/web/client"],
      "@lfaa/chat": ["./packages/core/chat/src"],
      "@lfaa/chat/client": ["./packages/core/chat/client"],
      "@lfaa/context": ["./packages/core/context/src"],
      "@lfaa/context/client": ["./packages/core/context/client"],
      "@lfaa/fs": ["./packages/core/fs/src"],
      "@lfaa/fs/client": ["./packages/core/fs/client"],
      "@lfaa/guard": ["./packages/core/guard/src"],
      "@lfaa/guard/client": ["./packages/core/guard/client"],
      "@lfaa/jobs": ["./packages/core/jobs/src"],
      "@lfaa/jobs/client": ["./packages/core/jobs/client"],
      "@lfaa/llm": ["./packages/core/llm/src"],
      "@lfaa/llm/ark-plan": ["./packages/core/llm/src/ark-plan.ts"],
      "@lfaa/llm/client": ["./packages/core/llm/client"],
      "@lfaa/memory": ["./packages/core/memory/src"],
      "@lfaa/memory/client": ["./packages/core/memory/client"],
      "@lfaa/metrics": ["./packages/core/metrics/src"],
      "@lfaa/metrics/client": ["./packages/core/metrics/client"],
      "@lfaa/plugins": ["./packages/extension/plugins/src"],
      "@lfaa/plugins/contract": ["./packages/extension/plugins/contract/index.ts"],
      "@lfaa/plugins/client": ["./packages/extension/plugins/client"],
      "@lfaa/pwsh-local": ["./packages/shell/pwsh-local/src"],
      "@lfaa/pwsh-local/client": ["./packages/shell/pwsh-local/client"],
      "@lfaa/rules": ["./packages/core/rules/src"],
      "@lfaa/rules/client": ["./packages/core/rules/client"],
      "@lfaa/sandbox": ["./packages/sandbox/sandbox/src"],
      "@lfaa/sandbox/client": ["./packages/sandbox/sandbox/client"],
      "@lfaa/sandbox-local": ["./packages/sandbox/sandbox-local/src"],
      "@lfaa/sandbox-local/client": ["./packages/sandbox/sandbox-local/client"],
      "@lfaa/sections": ["./packages/workspace/sections/src"],
      "@lfaa/sections/client": ["./packages/workspace/sections/client"],
      "@lfaa/session": ["./packages/core/session/src"],
      "@lfaa/session/client": ["./packages/core/session/client"],
      "@lfaa/settings": ["./packages/core/settings/src"],
      "@lfaa/settings/client": ["./packages/core/settings/client"],
      "@lfaa/shell": ["./packages/shell/shell/src"],
      "@lfaa/shell/client": ["./packages/shell/shell/client"],
      "@lfaa/shell-env": ["./packages/shell/shell-env/src"],
      "@lfaa/shell-env/client": ["./packages/shell/shell-env/client"],
      "@lfaa/skills": ["./packages/extension/skills/src"],
      "@lfaa/skills/contract": ["./packages/extension/skills/contract/index.ts"],
      "@lfaa/skills/client": ["./packages/extension/skills/client"],
      "@lfaa/storage": ["./packages/core/storage/src"],
      "@lfaa/storage/client": ["./packages/core/storage/client"],
      "@lfaa/subagent": ["./packages/core/subagent/src"],
      "@lfaa/subagent/client": ["./packages/core/subagent/client"],
      "@lfaa/tool-todo": ["./packages/core/tool-todo/src"],
      "@lfaa/tool-todo/client": ["./packages/core/tool-todo/client"],
      "@lfaa/tools": ["./packages/core/tools/src"],
      "@lfaa/tools/client": ["./packages/core/tools/client"],
      "@lfaa/ui-layout": ["./packages/ui/layout/src"],
      "@lfaa/ui-layout/client": ["./packages/ui/layout/client"],
      "@lfaa/ui-primitives": ["./packages/ui/primitives/src"],
      "@lfaa/ui-primitives/client": ["./packages/ui/primitives/client"],
      "@lfaa/ui-theme": ["./packages/ui/theme/src"],
      "@lfaa/ui-theme/client": ["./packages/ui/theme/client"],
      "@lfaa/web-server": ["./packages/host/web-server/src"],
      "@lfaa/web-server/client": ["./packages/host/web-server/client"],
      "@lfaa/workspace": ["./packages/workspace/workspace/src"],
      "@lfaa/workspace/client": ["./packages/workspace/workspace/client"]
    }
  }
}
