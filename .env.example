# 功能：提供 LFAA 本机开发环境的配置模板。
# 作用：集中声明控制端监听、运行数据目录和签名密钥，不包含真实秘密。
# 关联文件：packages/util/launch-environment/src/config.ts、README.md。
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
# 留空默认将插件安装文件放在当前系统账户的 .lfaa/plugins；一般保持默认即可。
# 可选：设置为绝对路径以更改安装根。此根与用户数据迁移分开管理。
LFAA_HOME=
# 留空默认使用 LFAA_HOME/data；Windows 通常位于 C:\Users\用户名\.lfaa\data，不随项目盘符改变。
# 设置中心“项目与存储”保存所选业务 Data 根；切换后旧目录保留，重启后控制端与本机 Daemon 统一使用新根。显式填写此项时由部署配置优先控制。
# Linux 生产服务应显式设置到有写权限的持久化目录，例如 /var/lib/lfaa；不要把生产数据放进源码仓库。
LFAA_DATA_DIR=
# 开发或 web 命令的本机回环监听留空时，签名密钥保存在 LFAA_HOME/credentials/jwt-secret；公网生产监听必须配置。
JWT_SECRET=
# web 命令自动启用本机模式；只在 localhost、127.0.0.0/8 或 ::1 监听时允许本机持久密钥。
# 要求按普通生产部署显式配置签名密钥时，可设置 LFAA_LOCAL_MODE=false。
# 开发环境留空时，通行密钥使用 RP ID localhost 和 Origin http://localhost:5173。
# 生产环境同时填写实际域名与 HTTPS Origin；两项留空时生产环境不会启用通行密钥。
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
# GitHub App 外部应用连接。为 App 启用 Device Flow，并在 GitHub App Permissions 中设置 Metadata/Issues/Pull requests 为 Read-only。
# Client ID 是公开标识；Client Secret 只保存在控制端，用于用户主动断开时撤销 GitHub 授权。
LFAA_GITHUB_APP_CLIENT_ID=
LFAA_GITHUB_APP_CLIENT_SECRET=
# 远程节点须使用 HTTPS；控制端位于同机 TLS 反向代理之后时，显式信任回环代理的转发协议。
# 仅当控制端监听回环地址且由受信任代理访问时启用；不要将未受保护的 HTTP 端口暴露到公网。
LFAA_TRUST_LOOPBACK_PROXY=false
