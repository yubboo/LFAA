# 功能：提供 LFAA 本机开发环境的配置模板。
# 作用：集中声明控制端监听、运行数据目录和签名密钥，不包含真实秘密。
# 关联文件：packages/util/launch-environment/src/config.ts、README.md。
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
# 默认 data：Windows 固定盘使用当前用户 %USERPROFILE%\.lfaa\data；可移动盘和开发环境跟随项目根目录。
# Windows 完整开发启动器和桌面端可在“设置中心 > LFAA 配置 > 项目与存储”中安排安全迁移；外部系统环境变量优先于设置页。
# Linux 生产服务应显式设置到有写权限的持久化目录，例如 /var/lib/lfaa；不要把生产数据放进源码仓库。
LFAA_DATA_DIR=data
# 开发或 web 命令的本机回环监听留空时，持久保存 LFAA_DATA_DIR/credentials/jwt-secret；公网生产监听必须配置。
JWT_SECRET=
# web 命令自动启用本机模式；只在 localhost、127.0.0.0/8 或 ::1 监听时允许本机持久密钥。
# 要求按普通生产部署显式配置签名密钥时，可设置 LFAA_LOCAL_MODE=false。
# 开发环境留空时，通行密钥使用 RP ID localhost 和 Origin http://localhost:5173。
# 生产环境同时填写实际域名与 HTTPS Origin；两项留空时生产环境不会启用通行密钥。
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
# 远程节点须使用 HTTPS；控制端位于同机 TLS 反向代理之后时，显式信任回环代理的转发协议。
# 仅当控制端监听回环地址且由受信任代理访问时启用；不要将未受保护的 HTTP 端口暴露到公网。
LFAA_TRUST_LOOPBACK_PROXY=false
