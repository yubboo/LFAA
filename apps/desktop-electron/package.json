{
  "name": "lfaa-desktop-electron",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "main": "src/main.mjs",
  "description": "LFAA Windows 本机一体版桌面外壳",
  "scripts": {
    "dev": "electron .",
    "test:update-manifest": "node --test tests/update-manifest.test.mjs tests/update-flow.test.mjs tests/update-prompt-broker.test.mjs",
    "validate:update-manifest": "node scripts/update-manifest.mjs validate",
    "package:win": "node scripts/update-manifest.mjs validate && node scripts/prepare-runtime.mjs prepare-deploy && pnpm --filter @yubboo/lfaa deploy --prod --legacy --config.node-linker=hoisted --config.confirmModulesPurge=false --config.allowUnusedPatches=true ../../dist/.tmp/desktop-electron/server-deploy && pnpm install --config.confirmModulesPurge=false && pnpm --filter lfaa-web run build:desktop-candidate && node scripts/prepare-runtime.mjs && electron-builder --win nsis --x64 --publish never && node scripts/verify-packaged-runtime.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.lfaa.desktop",
    "productName": "LFAA",
    "directories": {
      "output": "../../dist/apps/desktop-electron",
      "buildResources": "../../dist/.tmp/desktop-electron/build-resources"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist/.tmp/desktop-electron/runtime",
        "to": "app-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../dist/.tmp/desktop-electron/server-deploy/node_modules",
        "to": "app-runtime/apps/cli/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/lfaa.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LFAA-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/yubboo/LFAA/releases/latest/download/"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "nsis/installer.nsh",
      "license": "installation-notice.txt",
      "installerIcon": "lfaa.ico",
      "uninstallerIcon": "lfaa.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    }
  }
}
