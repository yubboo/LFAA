{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LFAA",
  "version": "0.1.1",
  "identifier": "com.lfaa.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../dist/apps/web"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["local-server-ui"],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "LFAA 本机主机服务与应用工作台",
    "icon": ["../../../dist/.tmp/desktop-tauri/LFAA.ico"],
    "resources": {
      "../../../dist/.tmp/desktop-tauri/app-runtime/": "app-runtime/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
