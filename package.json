{
  "name": "lfaa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "description": "LFAA workspace command entry point",
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "dev:services": "pnpm --recursive --parallel --filter @yubboo/lfaa --filter lfaa-web --filter lfaa-daemon run dev",
    "dev:frontend": "pnpm --filter lfaa-web run dev",
    "dev:server": "pnpm --filter @yubboo/lfaa run dev",
    "dev:daemon": "pnpm --filter lfaa-daemon run dev",
    "build": "pnpm run build:harness && pnpm run build:web && pnpm run build:control-plane && pnpm run build:cli",
    "test": "pnpm --filter @yubboo/lfaa run test",
    "build:web": "pnpm --filter lfaa-web run build",
    "build:control-plane": "pnpm --filter @yubboo/lfaa run build",
    "build:daemon": "pnpm --filter lfaa-daemon run build",
    "build:harness": "node scripts/build-harness.mjs packages",
    "build:cli": "node scripts/package-cli.mjs",
    "pack:cli": "pnpm run build && npm pack ./dist/npm/lfaa --pack-destination ./dist/npm",
    "publish:cli": "pnpm run build && npm publish ./dist/npm/lfaa --access public",
    "build:desktop:win": "pnpm run build:web && pnpm run build:control-plane && pnpm run build:daemon && node apps/desktop-tauri/scripts/package-windows.mjs",
    "build:desktop:electron:win": "pnpm run build:web && pnpm run build:control-plane && pnpm run build:daemon && pnpm --filter lfaa-desktop-electron run package:win",
    "lfaa": "node apps/cli/bin/lfaa.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "@types/express": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^24.0.0",
    "socket.io-client": "4.8.4",
    "tsx": "^4.0.0",
    "esbuild": "^0.21.5",
    "@types/js-yaml": "^4.0.0"
  }
}
