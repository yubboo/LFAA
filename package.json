{
  "name": "lfaa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "lfaa": "node scripts/ensure-lib.mjs && tsx apps/cli/src/bin.ts",
    "check": "node scripts/check-workspace.mjs && node scripts/check-client-layout.mjs && node scripts/check-architecture.mjs && node scripts/check-logs.mjs && node scripts/check-doc-links.mjs && node scripts/gen-repository-map.mjs --check",
    "check:arch": "node scripts/check-architecture.mjs",
    "map:sync": "node scripts/gen-repository-map.mjs",
    "lint": "node scripts/lint-workspace.mjs",
    "test": "node scripts/test.mjs",
    "test:pkg": "node scripts/test.mjs --filter",
    "probe:loader": "node scripts/probe-loader.mjs",
    "probe:boot": "node --import tsx scripts/probe-boot.mjs",
    "verify:web": "node --import tsx scripts/verify-web.mts",
    "verify:hover-scroll": "node --import tsx scripts/verify-hover-scroll.mts",
    "verify:stream-scroll": "node --import tsx scripts/verify-stream-scroll.mts",
    "ui:shot": "node --import tsx scripts/ui-shot.mts",
    "ui:shot:list": "node --import tsx scripts/ui-shot.mts --list",
    "verify:coordination": "node --import tsx scripts/verify-coordination.mts",
    "verify:canvas-motion": "node --import tsx scripts/verify-canvas-motion.mts",
    "build": "node scripts/build.mjs",
    "build:lib": "tsc -b tsconfig.host.json",
    "build:bundle": "tsdown",
    "build:web": "pnpm --filter @lfaa/app-web run build",
    "build:desktop": "pnpm run package:desktop",
    "build:desktop:dir": "pnpm run package:desktop:dir",
    "build:desktop:app": "pnpm --filter @lfaa/app-desktop run build && pnpm --filter @lfaa/app-desktop-host run build",
    "build:desktop:host": "pnpm --filter @lfaa/app-desktop-host run build",
    "start:desktop": "pnpm --filter @lfaa/app-desktop run start",
    "package:desktop": "pnpm --filter @lfaa/app-desktop run package",
    "package:desktop:dir": "pnpm --filter @lfaa/app-desktop run package:dir",
    "desktop": "pnpm run start:desktop",
    "typecheck": "tsc -b tsconfig.host.json && tsc -p apps/desktop/tsconfig.json --noEmit --composite false --incremental false && tsc -p apps/desktop-host/tsconfig.json --noEmit --composite false --incremental false",
    "readme:sync": "node scripts/sync-readmes.mjs .",
    "readme:pair": "node scripts/verify-translation-pairing.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "sync": "node scripts/sync-tsconfig.mjs . && node scripts/sync-manifests.mjs . && node scripts/sync-readmes.mjs .",
    "check:layout": "node scripts/check-client-layout.mjs",
    "check:docs": "node scripts/check-doc-links.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "js-yaml": "^4.3.2",
    "playwright-core": "^1.65.1",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
